# Browser-safe Supabase configuration from the project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Canonical application origin used for authentication confirmation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server-only local model configuration. No model is downloaded or
# contacted during application startup, build, or automated tests.
STYLUS_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
STYLUS_AI_OLLAMA_MODEL=

# Optional server-only OpenAI-compatible provider. Never prefix these with
# NEXT_PUBLIC. Pricing is deployment metadata used only for cost estimates.
STYLUS_AI_OPENAI_COMPATIBLE_BASE_URL=
STYLUS_AI_OPENAI_COMPATIBLE_MODEL=
STYLUS_AI_OPENAI_COMPATIBLE_API_KEY=
STYLUS_AI_REMOTE_INPUT_USD_PER_MILLION=
STYLUS_AI_REMOTE_OUTPUT_USD_PER_MILLION=

# Optional TASK-012 worker broker only. Keep server-side; never copy to the
# browser or Windows worker. Ordinary Stylus and DATABASE Cron do not require it.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret used by Vercel Cron to authenticate the bounded hosted
# SERVERLESS job executor. Generate a high-entropy value in the deployment.
CRON_SECRET=

# Optional TASK-017C Reddit Data API integration. Enable only after Reddit has
# approved this exact deployed use case. All values remain server-only. When
# disabled or incomplete, Reddit returns a safe unavailable source and Stylus
# continues with other planned source families where evidence exists.
STYLUS_REDDIT_API_ENABLED=false
STYLUS_REDDIT_CLIENT_ID=
STYLUS_REDDIT_CLIENT_SECRET=
STYLUS_REDDIT_USER_AGENT=
# Optional comma-separated subset of the code-owned Marketing registry IDs.
STYLUS_REDDIT_COMMUNITY_IDS=

# Optional TASK-017E legitimate web-discovery provider. This key is server-only.
# Stylus requests Tavily basic search metadata only; fetched evidence still
# passes independent URL policy, robots policy, pinned-DNS safe-fetch and
# relevance validation. No provider snippets are persisted.
STYLUS_WEB_DISCOVERY_TAVILY_API_KEY=
