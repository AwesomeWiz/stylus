# Copy to apps/web/.env.local for manual setup. Never commit real values.
# Or use scripts/setup-local-env.mjs with an already-running local Supabase stack.

# REQUIRED / BROWSER: origin and public Connect values for your backend.
# Embedded at build time; rebuild after changes. Replace placeholders before use.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_public_key

# OPTIONAL / SERVER CONFIGURATION: public HTTPS URL of the exact corresponding
# source for your deployment, shown in Settings. No credentials/query parameters.
# Defaults to the upstream repository; modified forks must offer their own source.
STYLUS_SOURCE_URL=

# OPTIONAL / SERVER: trusted integrations, worker broker and server workflows.
# From your backend's server credentials. Core startup does not require this.
# Never give the service-role key to a browser or Windows worker.
SUPABASE_SERVICE_ROLE_KEY=
# OPTIONAL / SERVER: strong random secret for a configured hosted Cron executor.
CRON_SECRET=

# OPTIONAL / SERVER: AI; no model is contacted/downloaded at startup or build.
# Operator-reachable Ollama; never expose a developer laptop's Ollama publicly.
STYLUS_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
STYLUS_AI_OLLAMA_MODEL=
# Existing OpenAI-compatible adapter; Core needs no provider or paid API account.
STYLUS_AI_OPENAI_COMPATIBLE_BASE_URL=
STYLUS_AI_OPENAI_COMPATIBLE_MODEL=
STYLUS_AI_OPENAI_COMPATIBLE_API_KEY=
# Optional operator pricing estimates, nonnegative USD per million tokens.
STYLUS_AI_REMOTE_INPUT_USD_PER_MILLION=
STYLUS_AI_REMOTE_OUTPUT_USD_PER_MILLION=

# OPTIONAL / SERVER: provider credential encryption; configure with providers only.
# Generate a base64 32-byte key securely; see docs/INTEGRATIONS.md for JSON shape,
# key IDs, rotation, exact callbacks and permissions. No working key is included.
STYLUS_INTEGRATION_KEY_ID=
STYLUS_INTEGRATION_KEYS=
# GitHub App settings, configured once by the deployment operator (not a PAT).
STYLUS_GITHUB_APP_ID=
STYLUS_GITHUB_APP_SLUG=
STYLUS_GITHUB_CLIENT_ID=
STYLUS_GITHUB_CLIENT_SECRET=
STYLUS_GITHUB_PRIVATE_KEY=
# Google Web OAuth client, configured once by the deployment operator.
STYLUS_GOOGLE_CLIENT_ID=
STYLUS_GOOGLE_CLIENT_SECRET=

# OPTIONAL / SERVER: approved external research. Missing sources degrade locally.
STYLUS_WEB_DISCOVERY_TAVILY_API_KEY=
# Enable only after Reddit approves this exact deployment/use case.
STYLUS_REDDIT_API_ENABLED=false
STYLUS_REDDIT_CLIENT_ID=
STYLUS_REDDIT_CLIENT_SECRET=
STYLUS_REDDIT_USER_AGENT=
# Optional comma-separated subset of code-owned Marketing community registry IDs.
STYLUS_REDDIT_COMMUNITY_IDS=

# OPTIONAL / WORKER PROCESS ONLY: set in that process; web dotenv is not loaded by
# the worker. See docs/WINDOWS_WORKER.md. Install binaries/models separately.
# STYLUS_WORKER_FFMPEG=ffmpeg
# STYLUS_WORKER_FFPROBE=ffprobe
# STYLUS_WORKER_WHISPER_CPP_PATH=PATH_TO_YOUR_WHISPER_CLI
# STYLUS_WORKER_WHISPER_MODEL_PATH=PATH_TO_YOUR_LOCAL_MODEL
